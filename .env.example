# ============================================================================
# VARIABLES DE ENTORNO — GESTOR OPERATIVO DE PERSONAL Y CUADRANTES (U.G. / U.S.)
# Copiar a .env local y rellenar con secretos únicos en producción.
# NUNCA subir .env real ni credenciales a Git.
# ============================================================================

# Entorno de ejecución ('development' | 'production')
NODE_ENV=development
PORT=3000

# Secretos criptográficos obligatorios del servidor (mínimo 32 caracteres aleatorios cada uno)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET="REEMPLAZAR_CON_SECRETO_ALEATORIO_MIN_32_CHARS"
CSV_HMAC_SECRET="REEMPLAZAR_CON_SECRETO_HMAC_MIN_32_CHARS"

# Lista separada por comas de orígenes CORS autorizados en producción
# Ejemplo: https://app.mi-dominio.es,https://admin.mi-dominio.es
CORS_ALLOWED_ORIGINS=""

# Credenciales de Firebase Admin SDK (requerido para Auth Custom Tokens, Firestore servidor y FCM HTTP v1)
# Opción A: JSON serializado de la cuenta de servicio en una línea
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Opción B: Ruta local al archivo JSON de cuenta de servicio (Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=""
# ID de base de datos Firestore (si no es '(default)')
FIRESTORE_DATABASE_ID=""

# Correo emisor institucional autorizado para envío de documentos Excel vía Gmail OAuth
EMAIL_FROM_ADDRESS=""
VITE_GMAIL_SENDER_EMAIL=""

# Clave API de Gemini (exclusivamente para OCR de matrículas autenticado /api/matriculas/ocr-frame)
GEMINI_API_KEY=""

# URL pública de la aplicación para enlaces y callbacks
APP_URL=""

# Solo activar explícitamente en entornos locales de desarrollo/pruebas (NUNCA 'true' en producción)
VITE_ENABLE_DEV_SEED="false"
ALLOW_PREVIEW_IFRAME="false"
